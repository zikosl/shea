:80 {
	encode zstd gzip

	@next_auth path /api/auth* /api/health
	reverse_proxy @next_auth admin:3000

	@graphql path /api/graphql*
	handle @graphql {
		uri strip_prefix /api
		reverse_proxy backend:3001
	}

	@store_sync path /api/pos-sync/*
	handle @store_sync {
		uri strip_prefix /api/pos-sync
		reverse_proxy {$CLOUD_GATEWAY_UPSTREAM:host.docker.internal:3520}
	}

	handle /uploads/* {
		root * /srv
		file_server
	}

	@backend_health path /api/backend-health
	handle @backend_health {
		rewrite * /health
		reverse_proxy backend:3001
	}

	reverse_proxy admin:3000
}
