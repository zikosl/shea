generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CloudStoreStatus {
  ACTIVE
  SUSPENDED
}

enum SyncSource {
  CLOUD
  LOCAL_GATEWAY
  SOLO_POS
}

model CloudStore {
  id                 String           @id
  partnerId          Int
  code               String
  name               String
  timezone           String           @default("Africa/Algiers")
  status             CloudStoreStatus @default(ACTIVE)
  gatewayTokenHash   String?
  gatewayTokenIssuedAt DateTime?
  gatewayLastSeenAt  DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  products           CloudProduct[]
  sales              CloudSale[]
  events             SyncEvent[]
  cursors            SyncCursor[]

  @@unique([partnerId, code])
}

model CloudProduct {
  storeId          String
  productId        Int
  variantId        Int?
  name             String
  nameAr           String?
  variantName      String?
  sku              String?
  image             String?
  price             Float             @default(0)
  costPrice         Float             @default(0)
  discount          Float             @default(0)
  stock             Float             @default(0)
  reorderThreshold  Float             @default(0)
  trackInventory    Boolean           @default(true)
  available         Boolean           @default(true)
  visibleInPos      Boolean           @default(true)
  sourceUpdatedAt   DateTime
  updatedAt         DateTime           @updatedAt
  store             CloudStore        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, productId])
  @@index([storeId, visibleInPos])
}

model CloudSale {
  id            String      @id @db.Uuid
  storeId       String
  saleNumber    String
  terminalId    String?
  cashierId     String?
  cashierName   String?
  customerName  String?
  subtotal      Float
  discountTotal Float       @default(0)
  taxTotal      Float       @default(0)
  total         Float
  paymentMethod String
  occurredAt    DateTime
  createdAt     DateTime    @default(now())
  store         CloudStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items         CloudSaleItem[]

  @@unique([storeId, saleNumber])
  @@index([storeId, occurredAt])
}

model CloudSaleItem {
  id          String    @id @default(uuid()) @db.Uuid
  saleId      String    @db.Uuid
  productId   Int
  productName String
  quantity    Float
  unitPrice   Float
  discount    Float     @default(0)
  tax         Float     @default(0)
  total       Float
  sale        CloudSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SyncEvent {
  sequence       Int        @id @default(autoincrement())
  eventId        String     @unique @db.Uuid
  storeId        String
  idempotencyKey String
  source         SyncSource
  entityType     String
  entityId       String
  operation      String
  payload        Json
  entityVersion  Int        @default(1)
  occurredAt     DateTime
  createdAt      DateTime   @default(now())
  store          CloudStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, sequence])
}

model SyncCursor {
  storeId      String
  consumerId   String
  lastSequence Int        @default(0)
  updatedAt    DateTime   @updatedAt
  store        CloudStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, consumerId])
}
