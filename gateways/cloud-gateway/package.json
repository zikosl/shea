{
  "name": "@shea/cloud-gateway",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "node scripts/generate-prisma.cjs",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.12.0",
    "@prisma/client": "6.12.0",
    "@shea/pos-protocol": "file:../../packages/pos-protocol",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "prisma": "6.12.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
