generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-arm64-openssl-1.1.x"]
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
  PARTNER
  DRIVER
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum OrderSource {
  ONLINE
  POS
}

enum PartnerFeeType {
  NONE
  PERCENTAGE
  FIXED
  MIXED
}

enum ProductTemplateRequestStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum CatalogProposalEntityType {
  CATEGORY
  PRODUCT_TYPE
}

enum CatalogProposalStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

enum StockMovementType {
  SALE
  RETURN
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum SaleStatus {
  DRAFT
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum SyncEventStatus {
  PENDING
  PROCESSING
  SYNCED
  ERROR
  CONFLICT
}

enum SyncEventAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
}

model PartnerDeliverySchedule {
  id Int @id @default(autoincrement())

  time     String // "17:00"
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

// enum DeliveryStatus {
//   PARTNER_ACCEPTED
//   PARTNER_REJECTED
//   PARTNER_PENDING
//   DELEVRY_ACCEPTED
//   DELEVRY_PENDING
// }

enum AuthMethod {
  EMAIL_PASSWORD
  GOOGLE
  OTP
}

model User {
  id           Int        @id @default(autoincrement())
  email        String?    @unique
  passwordHash String? // only set when authMethod = EMAIL_PASSWORD
  phone        String?    @unique // only set when using OTP
  oauthId      String? // e.g. Google sub
  authMethod   AuthMethod
  role         Role
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // one‐to‐one relations for role‐specific data
  client             Client?
  partner            Partner?
  driver             Driver?
  admin              Admin?
  tokens             Token[]
  logs               Log[]
  auditLogs          AuditLog[]
  addresses          Address[]
  pushTokens         PushToken[]
  sales              Sale[]
  cashSessionsOpened CashSession[]   @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]   @relation("CashSessionClosedBy")
  stockMovements     StockMovement[]
}

model Address {
  id         Int        @id @default(autoincrement())
  userId     Int
  label      String
  address    String     @default("")
  latitude   Float
  longitude  Float
  isDefault  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])
  deliveries Delivery[]
  orders     Order[]
}

model Token {
  id           String   @id @default(uuid())
  userId       Int
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  firstname String  @default("")
  lastname  String  @default("")
  avatar    String  @default("")
  language  String  @default("en")
  theme           Boolean         @default(false) // Legacy: 0 DARK, 1 LIGHT
  themePreference ThemePreference @default(SYSTEM)
  userId          Int             @unique
  // add any client-only fields here
  Order     Order[]
}

model Partner_Niche {
  id Int @id @default(autoincrement())

  partner   Partner? @relation(fields: [partnerId], references: [id])
  partnerId Int?
  niche     Niche?   @relation(fields: [niche_id], references: [id])
  niche_id  Int?

  @@unique([niche_id, partnerId])
}

model Partner {
  id             Int             @id @default(autoincrement())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int             @unique
  // partner-only fields
  companyName    String
  online         Boolean         @default(false)
  avatar         String?
  latitude       Float           @default(0)
  longitude      Float           @default(0)
  address        String?
  feeType        PartnerFeeType @default(NONE)
  feeRate        Float          @default(0)
  fixedFee       Float          @default(0)
  Product        Product[]
  Order          Order[]
  devices        Device[]
  sales          Sale[]
  cashSessions   CashSession[]
  syncEvents     SyncEvent[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  partnerNiches  Partner_Niche[]
  templateRequests ProductTemplateRequest[]
  catalogProposals CatalogProposal[]
}

model Driver {
  id             Int             @id @default(autoincrement())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int             @unique
  firstname      String
  lastname       String
  latitude       Float           @default(0)
  longitude      Float           @default(0)
  online         Boolean         @default(false)
  isAvailable    Boolean         @default(true)
  orderDispatchs OrderDispatch[]
  deliveries     Delivery[]
  deliveryGroups DeliveryGroup[]
}

model Admin {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int      @unique
  // admin-only fields
  firstname  String
  lastname   String
  birthday   DateTime @default(now())
  city       Int      @default(16)
  privileges String[]
}

model Niche {
  id         Int             @id @default(autoincrement())
  name       String
  name_ar    String
  image      String
  categories Category[]
  brands     Brand[]
  partners   Partner_Niche[]
  catalogProposals CatalogProposal[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String
  name_ar      String
  image        String
  productTypes ProductType[]
  productTemplates ProductTemplate[]
  templateRequests ProductTemplateRequest[]
  catalogProposalCategories CatalogProposal[] @relation("CatalogProposalCategory")
  resolvedCatalogProposals CatalogProposal[] @relation("CatalogProposalResolvedCategory")
  niche        Niche?        @relation(fields: [niche_id], references: [id])
  niche_id     Int?
}

model ProductType {
  id          Int               @id @default(autoincrement())
  name        String
  name_ar     String
  category_id Int
  category    Category          @relation(fields: [category_id], references: [id])
  products    ProductTemplate[]
  templateRequests ProductTemplateRequest[]
  resolvedCatalogProposals CatalogProposal[] @relation("CatalogProposalResolvedProductType")

  @@index([category_id])
}

model Brand {
  id               Int               @id @default(autoincrement())
  name             String
  image            String
  niche            Niche?            @relation(fields: [niche_id], references: [id])
  niche_id         Int?
  productTemplates ProductTemplate[]
  templateRequests ProductTemplateRequest[]

  @@index([niche_id])
}

model Product {
  id                Int      @id @default(autoincrement())
  price             Float    @default(0)
  costPrice         Float?
  discount          Float    @default(0)
  available         Boolean  @default(true)
  stock             Int      @default(0)
  trackInventory    Boolean  @default(true)
  reorderThreshold  Int      @default(0)
  isVisibleInPos    Boolean  @default(true)
  onlineVisible     Boolean  @default(false)
  isActive          Boolean  @default(true)
  customName        String?
  customDescription String?
  customImages      String[] @default([])
  vendorSku         String?
  vendorBarcode     String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  partnerId Int
  variantId Int

  partner Partner @relation(fields: [partnerId], references: [userId])
  variant Variant @relation(fields: [variantId], references: [id])

  OrderItem      OrderItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([partnerId, variantId])
  @@index([partnerId, isActive, isVisibleInPos])
  @@index([vendorBarcode])
  @@index([vendorSku])
}

model Device {
  id         String    @id @default(uuid())
  deviceKey  String    @unique
  partnerId  Int
  name       String?
  platform   Platform
  appVersion String?
  lastSyncAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  partner      Partner       @relation(fields: [partnerId], references: [userId], onDelete: Cascade)
  sales        Sale[]
  cashSessions CashSession[]
  syncEvents   SyncEvent[]
  catalogProposals CatalogProposal[]

  @@index([partnerId])
  @@index([platform])
}

model Sale {
  id            String     @id @default(uuid())
  saleNumber    String     @unique
  partnerId     Int
  deviceId      String?
  cashierId     Int?
  sourceOrderId Int?
  status        SaleStatus @default(COMPLETED)
  customerName  String?
  note          String?
  subtotal      Float      @default(0)
  discountTotal Float      @default(0)
  taxTotal      Float      @default(0)
  total         Float      @default(0)
  costTotal     Float      @default(0)
  grossProfit   Float      @default(0)
  partnerFee    Float      @default(0)
  netProfit     Float      @default(0)
  completedAt   DateTime?
  voidReason    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  partner        Partner         @relation(fields: [partnerId], references: [userId], onDelete: Cascade)
  device         Device?         @relation(fields: [deviceId], references: [id])
  cashier        User?           @relation(fields: [cashierId], references: [id])
  sourceOrder    Order?          @relation(fields: [sourceOrderId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([partnerId, createdAt])
  @@index([partnerId, status])
  @@index([deviceId])
  @@index([cashierId])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   Int
  quantity    Float
  unitPrice   Float
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float
  costPrice   Float    @default(0)
  profit      Float    @default(0)
  productName String
  variantName String?
  createdAt   DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String
  method    PaymentMethod
  status    PaymentStatus @default(PAID)
  amount    Float
  reference String?
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method])
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     Int
  partnerId     Int
  userId        Int?
  saleId        String?
  type          StockMovementType
  quantityDelta Float
  stockBefore   Int
  stockAfter    Int
  reason        String?
  reference     String?
  createdAt     DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [userId], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])

  @@index([productId, createdAt])
  @@index([partnerId, createdAt])
  @@index([saleId])
  @@index([type])
}

model CashSession {
  id            String            @id @default(uuid())
  partnerId     Int
  deviceId      String?
  openedById    Int
  closedById    Int?
  status        CashSessionStatus @default(OPEN)
  openingAmount Float             @default(0)
  cashIn        Float             @default(0)
  cashOut       Float             @default(0)
  expectedCash  Float             @default(0)
  countedCash   Float?
  difference    Float?
  note          String?
  openedAt      DateTime          @default(now())
  closedAt      DateTime?

  partner  Partner @relation(fields: [partnerId], references: [userId], onDelete: Cascade)
  device   Device? @relation(fields: [deviceId], references: [id])
  openedBy User    @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedBy User?   @relation("CashSessionClosedBy", fields: [closedById], references: [id])

  @@index([partnerId, status])
  @@index([deviceId])
}

model SyncEvent {
  id             String          @id @default(uuid())
  partnerId      Int
  deviceId       String?
  idempotencyKey String
  entity         String
  action         SyncEventAction
  payload        Json
  status         SyncEventStatus @default(PENDING)
  error          String?
  attempts       Int             @default(0)
  createdAt      DateTime        @default(now())
  processedAt    DateTime?

  partner Partner @relation(fields: [partnerId], references: [userId], onDelete: Cascade)
  device  Device? @relation(fields: [deviceId], references: [id])

  @@unique([partnerId, idempotencyKey])
  @@index([partnerId, status, createdAt])
  @@index([deviceId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   Int?
  partnerId Int?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime @default(now())

  actor   User?    @relation(fields: [actorId], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [userId])

  @@index([actorId, createdAt])
  @@index([partnerId, createdAt])
  @@index([entity, entityId])
}

model ProductTemplate {
  id          Int    @id @default(autoincrement())
  name        String
  name_ar     String @default("")
  description String @default("")

  category_id     Int
  category        Category @relation(fields: [category_id], references: [id])
  product_type_id Int?
  productType     ProductType? @relation(fields: [product_type_id], references: [id])

  Brand    Brand? @relation(fields: [brand_id], references: [id])
  brand_id Int?

  variants Variant[]
  images   ProductImage[]
  requests ProductTemplateRequest[] @relation("ApprovedTemplateRequests")

  @@index([category_id])
}

model ProductTemplateRequest {
  id                 Int                          @id @default(autoincrement())
  name               String
  name_ar            String                       @default("")
  description        String                       @default("")
  images             String[]                     @default([])
  category_id        Int?
  product_type_id    Int?
  categoryProposalId String?
  productTypeProposalId String?
  brand_id           Int?
  partnerId          Int
  status             ProductTemplateRequestStatus @default(PENDING)
  rejectionReason    String?
  adminNote          String?
  approvedTemplateId Int?
  mergedIntoTemplateId Int?
  hasOrder           Boolean                      @default(false)
  posLocalId         String?
  posDeviceId        String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  partner          Partner          @relation(fields: [partnerId], references: [userId], onDelete: Cascade)
  category         Category?        @relation(fields: [category_id], references: [id])
  productType      ProductType?     @relation(fields: [product_type_id], references: [id])
  brand            Brand?           @relation(fields: [brand_id], references: [id])
  approvedTemplate ProductTemplate? @relation("ApprovedTemplateRequests", fields: [approvedTemplateId], references: [id])
  variants         ProductTemplateRequestVariant[]
  categoryProposal CatalogProposal? @relation("RequestCategoryProposal", fields: [categoryProposalId], references: [id], onDelete: SetNull)
  productTypeProposal CatalogProposal? @relation("RequestProductTypeProposal", fields: [productTypeProposalId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([category_id])
  @@index([product_type_id])
  @@index([brand_id])
  @@unique([partnerId, posLocalId])
}

model CatalogProposal {
  id                    String                    @id @default(uuid())
  partnerId             Int
  deviceId              String?
  localId               String
  entityType            CatalogProposalEntityType
  status                CatalogProposalStatus    @default(PENDING)
  name                  String
  name_ar               String                   @default("")
  description           String                   @default("")
  image                 String?
  nicheId               Int
  categoryId            Int?
  parentProposalId      String?
  resolvedCategoryId    Int?
  resolvedProductTypeId Int?
  rejectionReason       String?
  adminNote             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  reviewedAt            DateTime?

  partner Partner @relation(fields: [partnerId], references: [userId], onDelete: Cascade)
  device  Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  niche Niche @relation(fields: [nicheId], references: [id])
  category Category? @relation("CatalogProposalCategory", fields: [categoryId], references: [id])
  parentProposal CatalogProposal? @relation("CatalogProposalParent", fields: [parentProposalId], references: [id], onDelete: SetNull)
  childProposals CatalogProposal[] @relation("CatalogProposalParent")
  resolvedCategory Category? @relation("CatalogProposalResolvedCategory", fields: [resolvedCategoryId], references: [id])
  resolvedProductType ProductType? @relation("CatalogProposalResolvedProductType", fields: [resolvedProductTypeId], references: [id])
  categoryRequests ProductTemplateRequest[] @relation("RequestCategoryProposal")
  productTypeRequests ProductTemplateRequest[] @relation("RequestProductTypeProposal")

  @@unique([partnerId, localId])
  @@index([partnerId, status, createdAt])
  @@index([entityType, status, createdAt])
  @@index([parentProposalId])
}

model ProductTemplateRequestVariant {
  id        Int                    @id @default(autoincrement())
  requestId Int
  name      String?
  description String?
  sku       String?
  image     String?
  tags      String[]               @default([])
  price     Float?
  costPrice Float?
  stock     Int?
  reorderThreshold Int?
  trackInventory Boolean @default(true)
  localId   String?
  resolvedVariantId Int?

  request ProductTemplateRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ---------- VARIANTS ----------
model Variant {
  id   Int     @id @default(autoincrement())
  name String? // e.g. "Banana flavor", "Red color"
  description String?
  sku  String? @unique

  productId Int
  product   ProductTemplate @relation(fields: [productId], references: [id])

  images   ProductImage[]
  products Product[]
  tags     Tag[]
}

model Tag {
  id        Int     @id @default(autoincrement())
  value     String
  variant   Variant @relation(fields: [variantId], references: [id])
  variantId Int
}

// ---------- IMAGES (Reusable) ----------
model ProductImage {
  id      Int     @id @default(autoincrement())
  url     String  @unique
  altText String?

  variantId           Int?
  product_template_id Int?
  variant             Variant?         @relation(fields: [variantId], references: [id])
  ProductTemplate     ProductTemplate? @relation(fields: [product_template_id], references: [id])
}

model Order {
  id   Int      @id @default(autoincrement())
  date DateTime @default(now())

  deliveryTax Int   @default(0)
  appTax      Int   @default(0)
  storeTax    Int   @default(0)
  discount    Float @default(0)
  subtotal    Float @default(0)
  partnerGross Float @default(0)
  partnerFee   Float @default(0)
  partnerNet   Float @default(0)
  partnerFeeType PartnerFeeType @default(NONE)
  partnerFeeRate Float @default(0)
  partnerFixedFee Float @default(0)

  source             OrderSource @default(ONLINE)
  walkInCustomerName String?
  note               String?
  paymentMethod      String?

  partnerId Int
  clientId  Int
  addressId Int

  client  Client  @relation(fields: [clientId], references: [userId])
  partner Partner @relation(fields: [partnerId], references: [userId])
  address Address @relation(fields: [addressId], references: [id])

  createdAt      DateTime        @default(now())
  items          OrderItem[]
  orderDispatchs OrderDispatch[]
  delivery       Delivery?
  sales          Sale[]
}

model Delivery {
  id      Int @id @default(autoincrement())
  orderId Int @unique

  type   Int
  status Int @default(0)

  price       Float     @default(0)
  addressId   Int?
  scheduledAt DateTime?

  driverId        Int?
  deliveryGroupId Int?

  order         Order          @relation(fields: [orderId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [userId])
  address       Address?       @relation(fields: [addressId], references: [id])
  deliveryGroup DeliveryGroup? @relation(fields: [deliveryGroupId], references: [id])

  dispatches OrderDispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
}

model DeliveryGroup {
  id          Int      @id @default(autoincrement())
  scheduledAt DateTime
  status      Int      @default(0) // PLANNED | IN_PROGRESS | COMPLETED

  driverId Int?
  driver   Driver? @relation(fields: [driverId], references: [userId])

  deliveries Delivery[]

  createdAt DateTime @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  orderId   Int
}

model OrderDispatch {
  id         Int @id @default(autoincrement())
  deliveryId Int
  driverId   Int

  status    Int      @default(0) // SENT | EXPIRED | ACCEPTED | REJECTED
  sentAt    DateTime
  expiresAt DateTime

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  driver   Driver   @relation(fields: [driverId], references: [userId])
  order    Order?   @relation(fields: [orderId], references: [id])
  orderId  Int?

  @@index([deliveryId])
  @@index([driverId])
}

model Otp {
  id        String   @id @default(cuid())
  phone     String   @unique // Phone number in E.164 format (+1234567890)
  code      String // The OTP code (6-8 digits)
  expiresAt DateTime // When the OTP expires
  attempts  Int      @default(0) // Verification attempts counter
  verified  Boolean  @default(false) // Mark as verified after successful validation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

model Log {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  title_ar  String
  body_ar   String
  type      Int
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
}

model Pricing {
  id    Int         @id @default(autoincrement())
  name  PricingName @unique
  price Int
}

model PushToken {
  id       String   @id @default(cuid())
  userId   Int
  token    String   @unique
  platform Platform
  deviceId String?
  isActive Boolean  @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

enum Platform {
  ANDROID
  IOS
  WEB
  DESKTOP
}

// VIEWS

view ProductView {
  id                  Int      @unique
  name                String
  name_ar             String
  sku                 String
  variantName         String
  price               Float
  costPrice           Float?
  discount            Float
  stock               Int
  reorderThreshold    Int
  available           Boolean
  isVisibleInPos      Boolean
  onlineVisible       Boolean
  isActive            Boolean
  customName          String?
  customDescription   String?
  customImages        String[]
  vendorSku           String?
  vendorBarcode       String?
  notes               String?
  product_template_id Int
  partnerId           Int
  variantId           Int
  brand_id            Int
  product_type_id     Int?
  category_id         Int
}

view ProductTemplateView {
  id              Int
  name            String
  name_ar         String
  description     String
  product_type_id Int?
  brand_id        Int?
  category_id     Int
  niche_id        Int?
}

enum PricingName {
  APP_TAX
  NORMAL_DELIVERY_TAX
  GROUP_DELIVERY_TAX
  STORE_TAX
  PICKUP_TAX
}

view ProductTemplatePartnerPreview {
  product_template_id Int
  partnerId           Int

  name            String
  name_ar         String
  description     String
  product_type_id Int?
  category_id     Int
  brand_id        Int?

  variantId    Int
  variant_name String?
  variant_sku  String?

  product_id        Int
  price             Float
  costPrice         Float?
  discount          Float
  available         Boolean
  stock             Int
  reorderThreshold  Int
  isVisibleInPos    Boolean
  onlineVisible     Boolean
  isActive          Boolean
  customName        String?
  customDescription String?
  customImages      String[]
  vendorSku         String?
  vendorBarcode     String?
  notes             String?

  @@unique([product_template_id, partnerId])
  @@map("ProductTemplatePartnerPreview")
}
