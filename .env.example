# Shea deployment environment
# Copy to .env and replace every placeholder before running Docker Compose.

# Domain / TLS
SHEA_DOMAIN=shea.openzey.com
ACME_EMAIL=ops@example.com
NEXTAUTH_URL=https://shea.openzey.com
NEXTAUTH_SECRET=CHANGE_THIS_NEXTAUTH_SECRET

# PostgreSQL
POSTGRES_USER=shea
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_DB=shea
POSTGRES_PORT=5432

# App ports
BACKEND_PORT=3001
ADMIN_PORT=3000

# Runtime
NODE_ENV=production
LOG_LEVEL=info

# Browser-facing API URL
NEXT_PUBLIC_API_URL=https://shea.openzey.com/api
NEXT_PUBLIC_PUBLIC_URL=https://shea.openzey.com
PARTNER_PWA_GRAPHQL_URL=https://shea.openzey.com/api/graphql
PARTNER_PWA_BASE_PATH=/store

# CORS
CORS_ALLOWED_ORIGINS=https://shea.openzey.com

# JWT secrets
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_SECOND_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS

# Optional integrations
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
SMS_PROXY_TARGET=

# Partner/driver invite email
# Gmail requires an app password, not the normal account password.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USER_NAME=Shea

# App Store / Google Play review OTP account
# Keep this exact account limited to review/testing. Set APP_REVIEW_OTP_ENABLED=false to disable it.
APP_REVIEW_OTP_ENABLED=true
APP_REVIEW_OTP_PHONE=554706953
APP_REVIEW_OTP_CODE=123456

# Optional pgAdmin login
PGADMIN_EMAIL=admin@shea.io
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD
